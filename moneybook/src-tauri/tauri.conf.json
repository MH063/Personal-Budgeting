{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "个人记账",
  "version": "2.0.0",
  "identifier": "com.yourname.moneybook",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "个人记账",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCMDY5NzQ1NzBBMURDNzYKUldSMjNLRndSWmNHTzhqMlQ4MldhUndJRGp1MmVZaHZaR2NLeFFBWWJiZEwyMnFiYXZGbkhZSXcK",
      "endpoints": []
    },
    "sql": {
      "preload": ["sqlite:moneybook.db"]
    }
  }
}